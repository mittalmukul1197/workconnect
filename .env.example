# WorkConnect Environment Configuration
PORT=5000
NODE_ENV=development

# Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=workconnect-demo
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@workconnect-demo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_PROJECT_ID=workconnect-demo

# Translation API Configuration (LibreTranslate)
# VITE_ prefix means this is visible in the browser bundle — do not use private/secret keys here.
# Use a self-hosted LibreTranslate instance or a public mirror that allows CORS from browsers.
# Default: https://libretranslate.de (community mirror, no API key required)
# To use official libretranslate.com (requires paid API key): change URL and add key below.
VITE_LIBRETRANSLATE_URL=https://libretranslate.de
VITE_LIBRETRANSLATE_API_KEY=
